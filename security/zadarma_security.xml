<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_zadarma" model="ir.module.category">
            <field name="name">Zadarma Integration</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_zadarma_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_zadarma"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_zadarma_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_zadarma"/>
            <field name="implied_ids" eval="[(4, ref('group_zadarma_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="zadarma_call_company_rule" model="ir.rule">
            <field name="name">Zadarma Call — multi-company</field>
            <field name="model_id" ref="model_zadarma_call"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
